%------------------------------------------------------------------------------
% Tipo incollection -- capítulo de livro organizado por outra pessoa: "In:
% ORGANIZADOR (org.). Título do livro" (Manual, p. 44-45). Use editortype
% para org., coord., comp.; o padrão é ed.
%------------------------------------------------------------------------------

% Duas editoras em locais diferentes, separadas por ponto e vírgula
% (Manual, p. 30). Fonte: Wellcome Collection: Cerebral mechanisms in
% behavior: the Hixon Symposium, ed. Lloyd A. Jeffress, New York: John Wiley;
% London: Chapman & Hall, 1951.
% VERIFICAR: páginas do capítulo no livro.
@incollection{vonNeumann:1951:GLT,
  author     = {von Neumann, John},
  title      = {The general and logical theory of automata},
  editor     = {Jeffress, Lloyd A.},
  editortype = {ed.},
  booktitle  = {Cerebral mechanisms in behavior: the {Hixon} Symposium},
  address    = {New York},
  publisher  = {John Wiley; London: Chapman \& Hall},
  year       = {1951}
}


